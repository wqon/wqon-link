<aside class="loader">
    <img class="loading" src="/assets/loader.webp" />
</aside>

<style is:global>
    .loader {
        display: grid;
        grid-template: 1fr / 1fr;
        justify-items: center;
        align-items: center;
        position: fixed;
        inset: 0;
        background: var(--black);
        animation: 0.8s ease-in forwards toOrange;
        z-index: 128;
        opacity: 1;
        visibility: visible;
        transform: none;
    }
    @keyframes toOrange {
        from {
            background: var(--black);
        }
        to {
            background: var(--orange);
        }
    }
    .loading {
        width: calc(95px * var(--z));
        height: auto;
    }
    .loaded {
        opacity: 0;
        visibility: hidden;
        translate: -100% 0;
        transition:
            opacity 1s 1s ease-in,
            visibility 0s 2s,
            translate 0s 2s;
    }

    main {
        opacity: 0;
        transform: scale(0.9);
    }
    .loaded-content {
        opacity: 1;
        transform: none;
        transition:
            2s ease-in opacity,
            3s ease-out transform;
    }
    .from-left {
        animation: 6s ease-out forwards fromLeft;
    }
    @keyframes fromLeft {
        from {
            translate: -100% 0;
        }
        to {
            translate: 0;
        }
    }
</style>

<script is:inline>
    window.onload = () => {
        document.querySelector(".loader").classList.add("loaded");
        setTimeout(() => {
            document.querySelector("main").classList.add("loaded-content");
            document.querySelector(".drake").classList.add("from-left");
        }, 1600);
    };
</script>
