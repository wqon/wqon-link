---
import config from "../config.json";

const { title, description, canon, theme } = Astro.props;
---

<head>
    <meta charset="utf-8" />
    <title>{title ?? config.title}</title>
    <meta name="description" content={description ?? config.description} />
    <meta name="author" content='Lukáš "WQON" Nox' />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={theme ?? config.theme} />
    <link rel="canonical" href={canon ?? config.canon} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? config.og.title} />
    <meta
        property="og:description"
        content={description ?? config.og.description}
    />
    <meta property="og:image" content="https://wqon.link/assets/og.png" />
    <meta property="og:url" content={canon ?? config.canon} />

    <link
        rel="icon"
        type="image/png"
        href="/favicon-96x96.png?v=20260518"
        sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260518" />
    <link rel="shortcut icon" href="/favicon.ico?v=20260518" />
    <link
        rel="apple-touch-icon"
        sizes="180x180"
        href="/apple-touch-icon.png?v=20260518"
    />
    <meta name="apple-mobile-web-app-title" content="WQON" />
    <link rel="manifest" href="/site.webmanifest?v=20260518" />

    <script src="../lib/noDrag.js"></script>
    <script src="../lib/killHash.js"></script>
    <script
        data-goatcounter="https://stats.wqon.link/count"
        async
        src="//gc.zgo.at/count.js"></script>

    <a rel="me" href="https://mastoart.social/@wqon" style="display: none;"
        >Mastodon</a
    >
</head>
