---
import config from "../config.json";
---

<!-- Designed & developed with <3 by Lukáš "WQON" Nox. --><!-- For technical details see: https://github.com/wqon/wqon-link -->
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>EULA for WQON Fonts</title>
        <meta
            name="description"
            content="End User License Agreement for font software by WQON."
        />
        <meta name="author" content='Lukáš "WQON" Nox' />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" content={config.theme} />
        <link rel="canonical" href="https://wqon.link/eula/" />

        <meta property="og:type" content="website" />

        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png?v=20260518"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260518" />
        <link rel="shortcut icon" href="/favicon.ico?v=20260518" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png?v=20260518"
        />
        <meta name="apple-mobile-web-app-title" content="WQON" />
        <link rel="manifest" href="/site.webmanifest?v=20260518" />

        <script src="../lib/noDrag.js"></script>
        <script src="../lib/killHash.js"></script>
        <script
            data-goatcounter="https://stats.wqon.link/count"
            async
            src="//gc.zgo.at/count.js"></script>
        <style>
            :root {
                --black: #020226;
                --darkblue: #161860;
                --blue: #0c18c0;
                --violet: #6b5cf5;
                --softblue: #63abff;
                --orange: #ffba63;
                --red: #f96280;
                --white: #fffaf5;
                --16: 1rem;
                --32: 2rem;
                --48: 3rem;
                --64: 4rem;
                --x: 2.6;
                --y: 2.8;
                --z: 4;
            }

            ::selection {
                background: var(--blue);
                color: var(--red);
            }
            :focus {
                outline: none;
            }

            * {
                width: 100%;
                max-width: 100svw;
                height: auto;
                box-sizing: border-box;
                scrollbar-color: var(--darkblue) transparent;
                scroll-behavior: smooth;
                text-decoration: none;
                margin: 0;
                padding: 0;
            }
            html {
                font-size: 16px;
                font-family: sans-serif;
                line-height: 1.5;
                letter-spacing: 0.05rem;
            }
            body {
                background: var(--white);
                color: var(--black);
                overflow-x: hidden;
            }
            main {
                white-space: normal;
                word-break: break-word;
            }

            section {
                width: 768px;
                padding: 32px;
                margin: 128px auto;
            }
            ul {
                padding-left: 32px;
            }
            b {
                font-weight: 900;
            }

            h1,
            h2 {
                margin-top: 24px;
            }
            ul + p {
                margin-top: 24px;
            }
            p + p {
                margin-top: 24px;
            }

            a {
                color: var(--red);
            }
        </style>
    </head>

    <body>
        <main>
            <section>
                <h2>TL;DR (Simple Summary)</h2><p>
                    This license allows use of WQON fonts in unlimited personal
                    and commercial projects based on your purchased number of
                    Seats. You may use the fonts in design, branding, games,
                    apps, websites, and digital media. Embedding is allowed only
                    within the rules and formats defined in this license. You do
