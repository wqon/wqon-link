---
import "./global.css";
import "./fontface.css";
import Head from "../components/head.astro";
import Document from "../components/document.astro";
import Cursor from "../components/cursor.astro";

const { title, description, canon, theme, text } = Astro.props;
---

<!-- Designed & developed with <3 by Lukáš "WQON" Nox. --><!--
--><!-- For technical details see: https://github.com/wqon/wqon-link -->
<html lang="en">
    <Head title={title} description={description} canon={canon} theme={theme} />
    <body>
        <main>
            <section>
                <Document>
                    <slot />
                </Document>
            </section>
        </main>
        <Cursor />
    </body>
</html>
