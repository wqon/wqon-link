---
import "./global.css";
import "./fontface.css";
import Credit from "../components/credit.astro";
import Head from "../components/head.astro";
import Cursor from "../components/cursor.astro";

const { title, description, canon, noRobots, thanks } = Astro.props;
---

<Credit />
<html lang="en">
    <Head
        title={title}
        description={description}
        canon={canon}
        theme="#020226"
        noRobots={noRobots}
    />
    <body>
        <div class="loader"></div>
        <main>
            <aside>
                <a class="home" href="/" data-cursor="pointer">
                    back to links
                </a>
                {thanks && (
                    <img
                        class="thanks"
                        src="/assets/thanks.webp"
                        alt="Thanks! <3"
                    />
                )}
            </aside>
            <section>
                <pre>
                    <slot />
                </pre>
            </section>
            <aside>
                <a class="wn" href="/" data-cursor="pointer"></a>
            </aside>
        </main>
        <Cursor />
    </body>
</html>

<style is:global>
    body {
        min-height: 100svh;
        display: grid;
        place-items: center;
        background: var(--black);
        color: var(--orange);
    }

    .loader {
        position: fixed;
        inset: 0;
        background: transparent;
        animation:
            0.8s ease Fade,
            1.6s ease-out Filter;
        z-index: 128;
    }
    .loaded {
        display: none;
    }
    @keyframes Fade {
        from {
            background: var(--blue);
        }
        to {
            background: transparent;
        }
    }
    @keyframes Filter {
        from {
            backdrop-filter: brightness(0%);
        }
        to {
            backdrop-filter: brightness(100%);
        }
    }

    main {
        display: grid;
        align-items: center;
        justify-content: center;
        margin: var(--64) 0;
    }

    .home {
        text-align: center;
        z-index: 4;
    }
    .home:hover {
        color: var(--white);
    }

    .thanks {
        width: 100%;
        padding: 0 var(--96);
        margin: 0 auto;
        z-index: 3;
    }

    aside {
        z-index: 2;
    }
    section {
        margin-top: var(--32);
        margin-bottom: var(--48);
        z-index: 1;
    }
    aside:has(.thanks) + section {
        margin-top: 0;
    }

    pre {
        width: 768px;
        background: var(--orange);
        color: var(--darkblue);
        font-family: Hawthorn-Sans, monospace;
        font-weight: 300;
        font-size: 0.875rem;
        line-height: 2;
        white-space: pre-line;
        border-radius: calc(1rem / 4);
        box-shadow: 0 0 96px var(--blue);
        padding: var(--48);
        user-select: text;
        z-index: 8;
    }

    .wn {
        --wn: calc(7px * 4);
        display: block;
        mask: url("/assets/wnDarkOC.png") center / cover;
        width: var(--wn);
        height: var(--wn);
        image-rendering: pixelated;
        margin: 0 auto;
        animation: Rainbow 32s linear infinite;
        transition: transform 0.4s ease-in-out;
    }
    .wn:hover {
        transform: scale(1.125);
    }
    @keyframes Rainbow {
        100% {
            background: #e896f8;
        }
        85% {
            background: #f45252;
        }
        68% {
            background: #f29a36;
        }
        51% {
            background: #f2d636;
        }
        34% {
            background: #0edd49;
        }
        17% {
            background: #4e85f4;
        }
        0% {
            background: #e896f8;
        }
    }

    @media /* mobile */ (min-width: 1px) and (max-width: 768px) {
        .thanks {
            padding: 0 var(--48);
        }
        pre {
            border-radius: 0;
            padding: var(--32);
        }
    }
</style>

<script is:inline>
    window.onload = () => {
        setTimeout(() => {
            document.querySelector(".loader").classList.add("loaded");
        }, 1600);
    };
</script>
